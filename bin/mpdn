#!/usr/bin/env bash

function check-notification() {
	[[ $# -ne 2 ]] && return 4

	for tdx in $(seq 0 1 3)
	do
		update-notification "$1" "$2"
		sleep 1
	done

	clear-notification "$ID"
	return $?
}

function playback-notification() {
	[[ $# -ne 2 ]] && return 4

	local status=`cat ${1}/STATUS`

	if [[ "$status" == "playing" ]]
	then
		mpc pause &>/dev/null &
		update-notification "${1}" "${2}"
	elif [[ "$status" == "paused" ]]
	then
		mpc play &>/dev/null & 
		check-notification "$1" "$2" &
	else
		dunstify -r "$2" -h int:id:$2 -u critical "Failed:" "MPD is neither playing nor paused."
	fi

}

function update-notification() {
	local CACHE="$1" 
	local ID="$2"

	get-metadata "$CACHE"
	cache-cover "$CACHE"
	metadata-notify "$CACHE" "$ID"
}

function help-text() {
	cat << :
Usage: mpdn [chknpP]
	-c   Clear the current notification
	-h   Display this help text
	-k   Check the current status without making changes
	-n   Go to the next song and update notification
	-p   Go to the previous song and update notification
	-P   Toggle Play/Pause, clear after 3 seconds if playing leave up if paused
:
}

function main() {
	local here=$(dirname `realpath $0`)
	local OPTARG OPTIND opts

	source ${here}/../lib/cache_cover
	source ${here}/../lib/cache_deets
	source ${here}/../lib/clear
	source ${here}/../lib/get_config
	source ${here}/../lib/notify

	local CACHE=`get-config cache`
	local ID=`get-config dunst_id`

	[[ -d $CACHE   ]] || mkdir -vp "$CACHE"

	while getopts "chknpP" opt
	do
		case ${opt} in
			c) clear-notification "$ID" ; exit $? ;;
			h) help-text ; exit 0 ;;
			k) check-notification "$CACHE" "$ID" ; exit $? ;;
			n) mpc next &>/dev/null ; check-notification "$CACHE" "$ID" ; exit $? ;;
			p) mpc prev &>/dev/null ; check-notification "$CACHE" "$ID" ; exit $? ;;
			P) playback-notification "$CACHE" "$ID" ; exit $? ;;
			*) help-text ; exit 9 ;;
		esac
	done
}

main "$@"
